<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="icon" type="String">
            <label>The name of the icon to use for the K Menu button.</label>
            <default>start-here-kde</default>
        </entry>

        <entry name="drawSideImage" type="Bool">
            <label>Show side image</label>
            <default>true</default>
        </entry>
        <entry name="showTitles" type="Bool">
            <label>Show section titles</label>
            <default>true</default>
        </entry>
        <entry name="showSearch" type="Bool">
            <label>Show applications search bar</label>
            <default>true</default>
        </entry>
        <entry name="showTooltips" type="Bool">
            <label>Show action tooltips</label>
            <default>false</default>
        </entry>
        <entry name="showGenericName" type="Bool">
            <label>Detailed menu entries</label>
            <default>true</default>
        </entry>

        <entry name="showRecentApps" type="Bool">
            <label>Show "Quick Start" section</label>
            <default>true</default>
        </entry>
        <entry name="recentAppsType" type="Enum">
            <label>"Quick Start section contains"</label>
            <choices>
                <choice name="Recent"/>
                <choice name="MostUsed"/>
            </choices>
            <default>1</default>
        </entry>
        <entry name="numRecentApps" type="Int">
            <label>Max number of "Quick Start" entries</label>
            <default>3</default>
        </entry>

        <entry name="showRecentDocs" type="Bool">
            <label>Show "Recent Documents" submenu</label>
            <default>true</default>
        </entry>
        <entry name="numRecentDocs" type="Int">
            <label>Max number of "Recent Documents" entries</label>
            <default>15</default>
        </entry>

        <entry name="showSystem" type="Bool">
            <label>Show "My System" submenu</label>
            <default>true</default>
        </entry>

        <entry name="showSettings" type="Bool">
            <label>Show "Settings" submenu</label>
            <default>true</default>
        </entry>
    </group>

</kcfg>
