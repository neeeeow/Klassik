<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="selectedTimeZones" type="StringList">
            <label>A list of the configured time zones. Format is "Europe/London". Special entry "Local" indicates system time zone.</label>
            <default>Local</default>
        </entry>
        <entry name="lastSelectedTimezone" type="String">
            <label>When multiple time zones are configured, this is the one shown on widget restore.</label>
            <default>Local</default>
        </entry>

        <entry name="clockType" type="Enum">
            <label>The type of clock</label>
            <choices>
                <choice name="Digital"/>
                <choice name="Analog"/>
            </choices>
            <default>0</default>
        </entry>

        <entry name="showDate" type="Bool">
            <label>Display the date below the clock</label>
            <default>true</default>
        </entry>
        <entry name="showSeconds" type="Bool">
            <label>Display the date on the clock</label>
            <default>false</default>
        </entry>
        <entry name="showFrame" type="Bool">
            <label>Draw a frame around the clock</label>
            <default>true</default>
        </entry>
        <entry name="blinkingDots" type="Bool">
            <label>Blinking dots in the digital clock</label>
            <default>false</default>
        </entry>
        <entry name="use24hFormat" type="Bool">
            <label>Use 24-hour format</label>
            <default>true</default>
        </entry>
        <entry name="antialiasing" type="Bool">
            <label>Anti-alias the analogue clock</label>
            <default>false</default>
        </entry>

        <entry name="colorTheme" type="Enum">
            <label>Whether to use system colors, LCD effect, or custom colors for the lock</label>
            <choices>
                <choice name="System"/>
                <choice name="LCD"/>
                <choice name="Custom"/>
            </choices>
            <default>0</default>
        </entry>
        <entry name="fgColor" type="Color">
            <default>#000000</default>
        </entry>
        <entry name="shadowColor" type="Color">
            <default>#808080</default>
        </entry>
        <entry name="bgColor" type="Color">
            <default>#ffffff</default>
        </entry>

    </group>

</kcfg>
