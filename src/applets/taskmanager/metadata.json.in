{
    "KPlugin": {
        "Authors": [
            {
                "Name": "neeeeow"
            }
        ],
        "BugReportUrl": "https://github.com/neeeeow/Klassik/issues",
        "Category": "Windows and Tasks",
        "Description": "Classic KDE 3 style task manager",
        "EnabledByDefault": true,
        "Icon": "preferences-system-windows",
        "License": "GPLv3+",
        "Name": "Klassik Task Manager",
        "Version": "@PROJECT_VERSION@",
        "Website": "https://github.com/neeeeow/klassik"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-Provides": [
        "org.kde.plasma.multitasking"
    ]
}
