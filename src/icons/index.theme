[Icon Theme]
Name=KDE Modern Classic
Comment=A modern take on the KDE 2/3 Classic icons, drawn as SVG
Inherits=kdeclassic,breeze,hicolor
Example=folder
DisplayDepth=32
Directories=16x16/places,22x22/places,16x16/mimetypes,22x22/mimetypes,16x16/actions,22x22/actions,scalable/places,scalable/devices,scalable/mimetypes,scalable/actions,scalable/apps,scalable/emblems,scalable/status

[16x16/places]
Size=16
Context=Places
Type=Fixed

[22x22/places]
Size=22
Context=Places
Type=Fixed

[16x16/mimetypes]
Size=16
Context=MimeTypes
Type=Fixed

[22x22/mimetypes]
Size=22
Context=MimeTypes
Type=Fixed

[16x16/actions]
Size=16
Context=Actions
Type=Fixed

[22x22/actions]
Size=22
Context=Actions
Type=Fixed

[scalable/places]
Size=64
Context=Places
Type=Scalable
MinSize=8
MaxSize=512

[scalable/devices]
Size=64
Context=Devices
Type=Scalable
MinSize=8
MaxSize=512

[scalable/mimetypes]
Size=64
Context=MimeTypes
Type=Scalable
MinSize=8
MaxSize=512

[scalable/actions]
Size=64
Context=Actions
Type=Scalable
MinSize=8
MaxSize=512

[scalable/status]
Size=64
Context=Status
Type=Scalable
MinSize=8
MaxSize=512

[scalable/emblems]
Size=64
Context=Emblems
Type=Scalable
MinSize=8
MaxSize=512

[scalable/apps]
Size=64
Context=Applications
Type=Scalable
MinSize=8
MaxSize=512
